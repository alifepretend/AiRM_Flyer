    [ "btn_temp_dn:2.l", "pico:GND.2", "black", [] ],

    [ "btn_time_up:1.l", "pico:GP9", "green", [] ],
    [ "btn_time_up:2.l", "pico:GND.3", "black", [] ],

    [ "btn_time_dn:1.l", "pico:GP10", "blue", [] ],
    [ "btn_time_dn:2.l", "pico:GND.3", "black", [] ],

    [ "btn_recipe:1.l", "pico:GP11", "gray", [] ],
    [ "btn_recipe:2.l", "pico:GND.3", "black", [] ],

    [ "sw_door:2", "pico:GP12", "cyan", [] ],
    [ "sw_door:1", "pico:GND.4", "black", [] ],

    [ "bz1:2", "pico:GP13", "magenta", [] ],
    [ "bz1:1", "pico:GND.4", "black", [] ],

    [ "pico:GP14", "r_status:1", "green", [] ],
    [ "r_status:2", "led_status:A", "green", [] ],
    [ "led_status:C", "pico:GND.5", "black", [] ],

    [ "pico:GP15", "r_alert:1", "yellow", [] ],
    [ "r_alert:2", "led_alert:A", "yellow", [] ],
    [ "led_alert:C", "pico:GND.5", "black", [] ],

    [ "pico:GP16", "r_fan:1", "blue", [] ],
    [ "r_fan:2", "led_fan:A", "blue", [] ],
    [ "led_fan:C", "pico:GND.6", "black", [] ],

    [ "pico:GP18", "r_heater:1", "red", [] ],
    [ "r_heater:2", "led_heater:A", "red", [] ],
    [ "led_heater:C", "pico:GND.6", "black", [] ]
